# RemoteSudoTouch Linux client configuration
#
# The root-owned Unix socket used by the PAM helper. This should match the
# packaged systemd socket unit unless you intentionally customize both sides.
REMOTE_SUDO_TOUCH_SOCKET=/run/remote-sudo-touch.sock
#
# The loopback TCP endpoint exposed by the reverse SSH tunnel on Linux.
REMOTE_SUDO_TOUCH_TUNNEL_HOST=127.0.0.1
REMOTE_SUDO_TOUCH_TUNNEL_PORT=9876
#
# Timeout while opening the local forwarded connection.
REMOTE_SUDO_TOUCH_CONNECT_TIMEOUT=2
#
# Timeout while waiting for the Mac-side approval response.
REMOTE_SUDO_TOUCH_RESPONSE_TIMEOUT=15
#
# Legacy combined timeout. If set, it acts as the default for both timeout
# values above unless those are set explicitly.
# REMOTE_SUDO_TOUCH_TIMEOUT=30
#
# Clear stale sshd reverse-forward listeners on timeout and retry once.
REMOTE_SUDO_TOUCH_SELF_HEAL=1
